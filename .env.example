# Local backend configuration. Copy to backend/.env before running the API.
GROQ_API_KEY=replace-with-your-groq-api-key
LLM_MODEL=llama-3.3-70b-versatile
PG_DSN=postgresql+asyncpg://postgres:change-me@localhost:5432/enterprise_rag
MONGO_URI=mongodb://localhost:27017
MONGO_DB=enterprise_rag
CHROMA_DIR=chroma_db
POLICIES_GLOB=docs/policies/*.md
REPO_DOCS_GLOB=docs/repos/*.md

# Jira credentials belong in AWS Secrets Manager when the Jira integration exists.
# Do not put Jira credentials in this local environment file.
