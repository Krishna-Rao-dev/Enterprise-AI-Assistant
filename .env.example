# Required for intent routing and grounded answer generation.
GROQ_API_KEY=replace-with-your-groq-api-key
LLM_MODEL=llama-3.3-70b-versatile

# Local developer-mode connections. Docker Compose overrides the hostnames
# with its PostgreSQL and MongoDB service names.
PG_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_rag
MONGO_URI=mongodb://localhost:27017
MONGO_DB=enterprise_rag

# Index and source-document paths. Paths are resolved from the repository root
# (document globs) or backend directory (CHROMA_DIR).
CHROMA_DIR=chroma_db
POLICIES_GLOB=docs/policies/*.md
REPO_DOCS_GLOB=docs/repos/*.md

# Jira MCP integration. Jira actions are unavailable until these values are
# configured; read-only HR leave balance and approved leave requests use PG.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-jira-service-account@example.com
JIRA_API_TOKEN=replace-with-your-jira-api-token
JIRA_DEFAULT_PROJECT=PAY

# Comma-separated browser origins for direct API access.
ALLOWED_ORIGINS=http://localhost:5173

# Frontend build/dev settings.
VITE_USE_MOCK=false
VITE_API_USER_ID=u_isha
VITE_API_BASE_URL=
VITE_BACKEND_URL=http://localhost:8000
