aws_region = "us-east-1"

# The ECR repositories are created by Terraform. Push these tags before
# setting desired_count above zero.
frontend_image_tag = "v1"
backend_image_tag  = "v1"

# Create these Secrets Manager secrets and populate SecretString values before
# applying the ECS task definitions. Each ARN must contain a plain string,
# not a JSON object, because ECS injects the complete SecretString.
groq_api_key_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:enterprise-assistant/groq-key-REPLACE"
postgres_dsn_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:enterprise-assistant/postgres-dsn-REPLACE"
mongo_uri_secret_arn    = "arn:aws:secretsmanager:us-east-1:123456789012:secret:enterprise-assistant/mongo-uri-REPLACE"

# Optional Jira integration. Store a JSON object in this secret's SecretString:
# {"base_url":"https://company.atlassian.net","email":"svc@example.com","api_token":"...","default_project":"PAY"}
# jira_credentials_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:enterprise-assistant/jira-credentials-REPLACE"
jira_default_project = "PAY"

# For a custom domain, request/validate an ACM certificate in us-east-1 and set both:
# cloudfront_aliases                  = ["assistant.example.com"]
# cloudfront_acm_certificate_arn      = "arn:aws:acm:us-east-1:123456789012:certificate/REPLACE"
