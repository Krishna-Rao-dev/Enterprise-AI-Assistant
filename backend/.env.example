GROQ_API_KEY=gsk_...

# PostgreSQL
PG_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_rag

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=enterprise_rag

# Paths (defaults work if you keep docs/policies/ and docs/repos/)
POLICIES_GLOB=docs/policies/*.md
REPO_DOCS_GLOB=docs/repos/*.md
CHROMA_DIR=chroma_db

# Model (default: llama-3.3-70b-versatile on Groq)
LLM_MODEL=llama-3.3-70b-versatile
